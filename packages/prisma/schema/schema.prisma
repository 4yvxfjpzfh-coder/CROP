generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Business {
  id            String   @id @default(cuid())
  name          String
  description   String?
  address       String
  latitude      Float?
  longitude     Float?
  phone         String?
  email         String?  @unique
  category      String   // "restaurante", "panadería", "supermercado", etc.
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  discountCodes DiscountCode[]
  orders        Order[]
  products      Product[]
}

model User {
  id            String    @id @default(cuid())
  // email es opcional porque "Sign in with Apple" solo lo entrega en la primera
  // autorización; el adapter de Auth.js resuelve logins posteriores por Account.
  email         String?   @unique
  emailVerified DateTime?
  name          String?
  image         String?
  phone         String?
  role          Role      @default(USER)
  isActive      Boolean   @default(true)
  // Código corto y correlativo del cliente (1, 2, 3...), igual en todos sus
  // pedidos. Se muestra al cliente y al admin para identificar a la persona
  // al recoger, sin tener que usar el correo. Autoincrement de Postgres:
  // nunca se repite. No aplica a agricultores/admin, solo tiene sentido
  // para clientes, pero se numera parejo para todos (más simple que llevar
  // dos secuencias separadas).
  customerNumber   Int       @unique @default(autoincrement())
  // Hash de contraseña (scrypt) para cuentas creadas con correo + contraseña.
  // Null para cuentas que solo usan Apple o el login de desarrollo.
  passwordHash  String?
  // Protección contra fuerza bruta del login por contraseña: se cuentan los
  // intentos fallidos seguidos y, al pasar el tope, se bloquea el login por
  // un rato (ver MAX_FAILED_LOGIN_ATTEMPTS/LOCKOUT_MINUTES en auth.ts).
  failedLoginCount Int      @default(0)
  lockedUntil      DateTime?
  // Consentimiento de Política de Privacidad + Términos aceptado en el registro.
  consentedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  orders          Order[]
  accounts        Account[]
  sessions        Session[]
  auditLogs       AdminAuditLog[]
  // Productos que le pertenecen (rol FARMER). El admin asigna el rol y
  // vincula cada producto con /admin/agricultores; sin eso, un usuario común
  // no tiene ningún producto asociado.
  farmerProducts  Product[]       @relation("FarmerProducts")
}

enum Role {
  USER
  FARMER
  ADMIN
}

// --- Auth.js (NextAuth v5) — esquema estándar de @auth/prisma-adapter ---

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? @db.Text
  access_token             String? @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String? @db.Text
  session_state            String?
  refresh_token_expires_in Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Product {
  id                 String       @id @default(cuid())
  // businessId es opcional: el admin puede publicar excedente antes de tener
  // registrado al agricultor como Business.
  businessId         String?
  business           Business?    @relation(fields: [businessId], references: [id], onDelete: SetNull)
  // Punto de recogida asignado a este producto (feria del agricultor).
  pickupPointId      String?
  pickupPoint        PickupPoint? @relation(fields: [pickupPointId], references: [id], onDelete: SetNull)
  name               String
  description        String?
  // Nombre del agricultor/emprendedor que lo cultivó, a mano, sin cuenta
  // propia (el piloto centraliza la publicación en el admin). Solo texto
  // libre para mostrarlo en el catálogo, no crea un Business.
  providerName       String?
  // Cuenta real del agricultor (rol FARMER) dueño del producto, si la tiene.
  // Le permite entrar a /agricultor y ver/editar solo lo suyo. Opcional:
  // conviven productos con y sin agricultor vinculado.
  farmerId           String?
  farmer             User?        @relation("FarmerProducts", fields: [farmerId], references: [id], onDelete: SetNull)
  photoUrl           String?      // Foto del producto (o la imagen editada exportada por ProductPhotoEditor)
  // Fecha de la última cosecha, para mostrar "cosechado el ..." en el catálogo.
  harvestedAt        DateTime?
  // Nota corta libre para el catálogo: "Extra dulce", "No madura todavía", etc.
  ripenessNote       String?
  originalPriceCents Int          // Precio de referencia (por unidad o por kilo, según `unit`)
  discountPriceCents Int          // Precio de excedente (por unidad o por kilo, según `unit`)
  unit               ProductUnit  @default(UNIDAD)
  quantity           Float        @default(0) // Cantidad disponible, en unidades o en kilos según `unit`
  isActive           Boolean      @default(true)
  // Posición manual opcional para ordenar el catálogo. null = se ordena por
  // fecha de publicación. Ya no controla si el producto se muestra o no.
  catalogPosition    Int?
  // Número consecutivo por agricultor (1, 2, 3...), asignado al crear el
  // producto. Sirve para mostrar un código corto tipo "Manzana - Juan García #1".
  farmerSeq          Int?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  orderItems         OrderItem[]

  @@index([businessId, isActive])
  @@index([pickupPointId, isActive])
  @@index([catalogPosition])
  @@index([farmerId])
  // Evita que dos creaciones al mismo tiempo para el mismo agricultor
  // terminen con el mismo farmerSeq (nextFarmerSeq() por sí solo no es
  // atómico); con esto, la segunda falla en vez de duplicarse en
  // silencio, y el código que llama la reintenta. Postgres no choca por
  // NULL=NULL, así que los productos sin agricultor no se ven afectados.
  @@unique([farmerId, farmerSeq])
}

enum ProductUnit {
  UNIDAD
  KG
}

model PickupPoint {
  id        String   @id @default(cuid())
  name      String   // "Feria del Agricultor de Santa Ana"
  shortName String   // "Santa Ana"
  address   String
  latitude  Float?
  longitude Float?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products  Product[]
}

model AdminAuditLog {
  id         String           @id @default(cuid())
  actorId    String?
  actor      User?            @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String           // snapshot: sobrevive aunque se borre el usuario
  action     AdminAuditAction
  entityType String           // "Product"
  entityId   String?
  summary    String?          // descripción legible de lo que cambió
  metadata   Json?
  createdAt  DateTime         @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}

enum AdminAuditAction {
  PRODUCT_CREATE
  PRODUCT_UPDATE
  PRODUCT_DELETE
}

model DiscountCode {
  id              String    @id @default(cuid())
  businessId      String?
  business        Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  code            String    @unique
  type            String    // "PERCENTAGE", "FIXED_AMOUNT", "FREE_DELIVERY"
  value           Int       // Percentage (1-100) or cents
  minOrderCents   Int       @default(0)
  maxUses         Int?
  usedCount       Int       @default(0)
  startsAt        DateTime
  endsAt          DateTime
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())

  @@index([code, isActive])
}

model ImpactMetric {
  id                    String   @id @default(cuid())
  date                  DateTime @db.Date
  listingsCreated       Int      @default(0)
  itemsSold             Int      @default(0)
  weightKgRescued       Float    @default(0)
  co2eKgSaved           Float    @default(0)
  customerSavingsCents  Int      @default(0)
  businessRevenueCents  Int      @default(0)
  activeBusinesses      Int      @default(0)
  activeCustomers       Int      @default(0)
  deliveriesCompleted   Int      @default(0)
  averageDiscountPct    Float    @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([date])
}

model Order {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  // Opcional: el excedente puede apartarse aunque el agricultor todavía no
  // esté registrado como Business.
  businessId  String?
  business    Business?   @relation(fields: [businessId], references: [id], onDelete: SetNull)
  status      OrderStatus @default(RESERVED)
  pickupBy    DateTime    // Fecha límite para recoger antes de liberar el apartado
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  items       OrderItem[]

  @@index([userId, createdAt])
  @@index([businessId, status])
  @@index([status, pickupBy])
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  quantity       Float    @default(1) // en unidades o en kilos, según el producto
  unitPriceCents Int      // Precio de excedente al momento de apartar (por unidad o por kilo)
  createdAt      DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

enum OrderStatus {
  RESERVED
  PICKED_UP
  CANCELLED
  EXPIRED
}

// Fila única (id fijo "default") con preferencias editables desde
// /admin/settings: fondo, texto del home y ventana de recogida.
model SiteSettings {
  id                String   @id @default("default")
  homeBackgroundUrl String?
  // Titular y bajada del hero del home. Si están vacíos, se usa el texto
  // por defecto (hardcodeado en app/page.tsx) para que el home nunca quede
  // en blanco por un settings sin configurar.
  homeHeadline      String?
  homeSubtext       String?
  // Horas entre que se aparta un producto y se vence el apartado. Tope fijo
  // de 2 horas (ver MAX_PICKUP_WINDOW_HOURS en lib/site-settings.ts); el
  // admin puede poner menos, pero nunca más.
  pickupWindowHours Int      @default(2)
  updatedAt         DateTime @updatedAt
}

// Frutas del carrusel del home ("Lo que encontrás hoy"), editables desde
// /admin/settings. Si no hay ninguna, el home cae al set fijo por defecto.
model HomeFruit {
  id        String   @id @default(cuid())
  name      String
  imageUrl  String
  blurb     String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
}

// Textos sueltos de la app pública (menús, botones, páginas legales, etc.),
// editables desde /admin/textos. Tabla dispersa: solo existe una fila por
// texto que el admin efectivamente cambió; el resto usa el valor por defecto
// definido en código (apps/web/lib/site-text-defaults.ts) para que la app
// nunca se quede sin texto por una fila sin crear.
model SiteText {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}
