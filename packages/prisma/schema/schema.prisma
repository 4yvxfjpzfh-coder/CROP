generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Business {
  id            String   @id @default(cuid())
  name          String
  description   String?
  address       String
  latitude      Float?
  longitude     Float?
  phone         String?
  email         String?  @unique
  category      String   // "restaurante", "panadería", "supermercado", etc.
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  discountCodes DiscountCode[]
  orders        Order[]
  products      Product[]
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]
}

model Product {
  id                 String   @id @default(cuid())
  businessId         String
  business           Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name               String
  description        String?
  originalPriceCents Int      // Precio normal
  discountPriceCents Int      // Precio de excedente
  quantity           Int      @default(0) // Unidades disponibles para apartar
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  orderItems         OrderItem[]

  @@index([businessId, isActive])
}

model DiscountCode {
  id              String    @id @default(cuid())
  businessId      String?
  business        Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  code            String    @unique
  type            String    // "PERCENTAGE", "FIXED_AMOUNT", "FREE_DELIVERY"
  value           Int       // Percentage (1-100) or cents
  minOrderCents   Int       @default(0)
  maxUses         Int?
  usedCount       Int       @default(0)
  startsAt        DateTime
  endsAt          DateTime
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())

  @@index([code, isActive])
}

model ImpactMetric {
  id                    String   @id @default(cuid())
  date                  DateTime @db.Date
  listingsCreated       Int      @default(0)
  itemsSold             Int      @default(0)
  weightKgRescued       Float    @default(0)
  co2eKgSaved           Float    @default(0)
  customerSavingsCents  Int      @default(0)
  businessRevenueCents  Int      @default(0)
  activeBusinesses      Int      @default(0)
  activeCustomers       Int      @default(0)
  deliveriesCompleted   Int      @default(0)
  averageDiscountPct    Float    @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([date])
}

model Order {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  businessId  String
  business    Business    @relation(fields: [businessId], references: [id])
  status      OrderStatus @default(RESERVED)
  pickupBy    DateTime    // Fecha límite para recoger antes de liberar el apartado
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  items       OrderItem[]

  @@index([userId, createdAt])
  @@index([businessId, status])
  @@index([status, pickupBy])
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  quantity       Int      @default(1)
  unitPriceCents Int      // Precio de excedente al momento de apartar
  createdAt      DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

enum OrderStatus {
  RESERVED
  PICKED_UP
  CANCELLED
  EXPIRED
}
