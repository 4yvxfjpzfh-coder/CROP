{
  "name": "@crop/prisma",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "generate": "prisma generate --schema schema/schema.prisma",
    "migrate": "prisma migrate dev --schema schema/schema.prisma",
    "deploy": "prisma migrate deploy --schema schema/schema.prisma",
    "seed": "prisma db seed --schema schema/schema.prisma"
  },
  "prisma": {
    "seed": "tsx seed.ts",
    "schema": "schema/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0"
  },
  "devDependencies": {
    "prisma": "^6.19.3",
    "tsx": "^4.19.0"
  }
}
