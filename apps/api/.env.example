# ---- Base de datos (Prisma / Neon) ----
# Misma cadena que packages/prisma/.env
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ---- Cron ----
# Exigido por Authorization: Bearer <CRON_SECRET> en /api/cron/release-expired.
# Mismo valor que el secret CRON_SECRET del workflow de GitHub Actions
# (.github/workflows/release-expired-orders.yml).
CRON_SECRET="reemplazar"
