# ---- Base de datos (Prisma / Neon) ----
# Misma cadena que packages/prisma/.env
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ---- Auth.js (NextAuth v5) ----
# Generar con: npx auth secret
AUTH_SECRET="reemplazar"
# URL pública de esta app (Auth.js la usa para armar los callbacks OAuth).
# En Vercel: la URL de producción o de preview correspondiente.
AUTH_URL="http://localhost:3000"

# ---- Sign in with Apple ----
# Services ID creado en developer.apple.com (NO el App ID)
AUTH_APPLE_ID="com.crop.web"
# Client secret JWT (ES256) firmado con la clave .p8:
#   - Team ID + Key ID + clave privada .p8
#   - caduca máx. 6 meses; hay que regenerarlo
# Generar con: node apps/web/scripts/generate-apple-secret.mjs
AUTH_APPLE_SECRET="reemplazar"

# ---- Panel de administración ----
# Allowlist de correos con acceso admin (segunda capa, además del role en DB).
# Separados por coma, sin espacios.
ADMIN_EMAILS="tu-correo@ejemplo.com"

# ---- Almacenamiento de fotos de producto (Vercel Blob) ----
# Lo inyecta Vercel al conectar un store Blob. En local: `vercel blob store add`.
# Si falta, /api/admin/product-photo cae a un data URL de dev (no persiste).
BLOB_READ_WRITE_TOKEN=""

# ---- PayPal (pago en línea, opcional) ----
# Cobro centralizado a una sola cuenta de Crop -- NO reparte a cada
# agricultor; el admin liquida con cada uno aparte, igual que con el
# efectivo. Credenciales en developer.paypal.com -> Apps & Credentials ->
# crear una app. Empezar siempre en "sandbox"; recién al final, con
# credenciales reales, se cambia a "live". Sin estas variables, el botón de
# PayPal simplemente no aparece (pagar en efectivo/SINPE sigue funcionando).
PAYPAL_ENV="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
# El botón también necesita el client id en el navegador -- mismo valor que
# PAYPAL_CLIENT_ID de arriba, pero con prefijo NEXT_PUBLIC para poder
# exponerse al cliente (no es secreto, el client secret nunca lleva este prefijo).
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""
# Se obtiene al crear un Webhook en el dashboard de PayPal (misma app),
# apuntando a https://tu-dominio/api/paypal/webhook, eventos PAYMENT.CAPTURE.*.
# Sin esto el webhook de respaldo no puede verificar que un aviso venga de
# verdad de PayPal y lo rechaza -- el pago desde /api/paypal/capture sigue
# funcionando igual, esto es solo el respaldo para cuando el navegador del
# comprador se cierra antes de confirmar.
PAYPAL_WEBHOOK_ID=""
