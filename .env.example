# Variables de entorno de Crop (monorepo).
# Copiá los bloques relevantes a:
#   - packages/prisma/.env   (DATABASE_URL)
#   - apps/web/.env.local     (todo lo de la app web)
#   - apps/api/.env.local     (DATABASE_URL + CRON_SECRET)

# ---- Base de datos ----
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ---- Auth.js / Sign in with Apple (apps/web) ----
AUTH_SECRET="reemplazar"          # npx auth secret
AUTH_APPLE_ID="com.crop.web"      # Services ID de Apple
AUTH_APPLE_SECRET="reemplazar"    # client secret JWT firmado con la clave .p8

# ---- Panel de admin (apps/web) ----
ADMIN_EMAILS="tu-correo@ejemplo.com"

# ---- Cron de expiración de apartados (apps/api) ----
CRON_SECRET="reemplazar"
