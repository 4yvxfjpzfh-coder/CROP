{
  "name": "crop",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "postinstall": "prisma generate --schema packages/prisma/schema/schema.prisma"
  },
  "devDependencies": {
    "prisma": "^6.19.3",
    "turbo": "^2.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "pnpm": {
    "overrides": {
      "deepmerge-ts@<8.0.0": ">=8.0.0",
      "source-map-js@<1.2.2": ">=1.2.2",
      "sharp@<0.35.5": ">=0.35.5"
    }
  }
}
